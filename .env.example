# Copy to .env and fill in. .env is gitignored — never commit the real file.
#
# NOTE: target sites are NOT configured here. They live in
# config/sources/*.yaml (also gitignored). See config/sources/README.md.

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=adcrawler
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=adcrawler
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://adcrawler:change-me-before-first-run@db:5432/adcrawler

# ── Ports published on the host (5432 avoided: it collides with other apps) ────────────────────────────────────────────
API_PORT=8000
WEB_PORT=8080
DB_PORT=15432

# ── API ────────────────────────────────────────────────────────────────────
API_CORS_ORIGINS=http://localhost:8080
API_PAGE_SIZE_DEFAULT=50
API_PAGE_SIZE_MAX=200
LOG_LEVEL=INFO

# ── Crawler ────────────────────────────────────────────────────────────────
# Which files under config/sources/ to load. Comma-separated basenames
# (no extension), or "*" for all.
CRAWLER_SOURCES=*

# Minutes between crawl passes. Keep this HIGH — low request volume from a
# residential IP is the entire anti-blocking strategy. 20+ is sensible.
CRAWL_INTERVAL_MINUTES=180
TRIGGER_POLL_SECONDS=10

# Politeness. Randomised delay between requests, in seconds.
CRAWL_DELAY_MIN_SECONDS=4
CRAWL_DELAY_MAX_SECONDS=11
CRAWL_MAX_PAGES_PER_SEARCH=3
CRAWL_MAX_DETAILS_PER_RUN=40
DETAIL_REFRESH_DAYS=14
PHASH_MAX_PER_RUN=1200

# Persisted browser profile keeps cookies/clearance across runs, so you look
# like one returning human rather than a fresh client every time.
BROWSER_PROFILE_DIR=/data/browser-profile
BROWSER_HEADLESS=true
BROWSER_LOCALE=hr-HR
BROWSER_TIMEZONE=Europe/Zagreb

# ── Duplicate detection thresholds ─────────────────────────────────────────
# Bias toward splitting: a false merge silently HIDES a listing from you.
DEDUP_MERGE_AT=0.75
DEDUP_REVIEW_AT=0.45
DEDUP_RUNAWAY_SIZE=5
DEDUP_PHASH_MAX_DISTANCE=8

# ── AI scoring (optional; leave key empty to disable) ──────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_ENABLED=false

# ── Digest email (optional; leave host empty to disable) ───────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_TO=
DIGEST_HOUR=8
